# Copier ce fichier en `.env` puis remplacer par vos valeurs.
# Ces variables sont publiques (clés anon) : elles sont embarquées dans le bundle.
# En CI, elles sont injectées via les secrets GitHub (voir .github/workflows/deploy.yml).

VITE_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...votre_cle_anon...

# ── Mode d'interface (kill switch de build) ──────────────────────────────────
# Valeurs possibles : classic | galacticos | (variable ABSENTE = aucun forçage)
# - ABSENTE          : chaque utilisateur suit sa préférence (defaut: classic)
# - classic          : TOUT le monde est forcé en interface classique
# - galacticos       : TOUT le monde est forcé en mode galacticos
# Note : pour un forçage SANS redéploiement, utiliser la table `app_settings`
# (cle 'force_ui_mode', valeur {"mode":"classic"} ou {"mode":"galacticos"}).
# VITE_FORCE_UI_MODE=classic